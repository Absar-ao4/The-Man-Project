# Copy to .env (never commit .env). Used by docker-compose and, if you export them, by `./gradlew bootRun`.

# --- Database (PostgreSQL 16) -------------------------------------------------
# Link your own database here later. For a Postgres running on your machine:
#   DB_URL=jdbc:postgresql://localhost:5432/manproject
DB_URL=jdbc:postgresql://localhost:5432/manproject
DB_USER=manproject
DB_PASSWORD=change-me
# Only used by docker-compose to name the database it creates.
POSTGRES_DB=manproject

# --- Auth ---------------------------------------------------------------------
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- External APIs (needed from later phases; safe to leave blank for now) ------
ANTHROPIC_API_KEY=
USDA_API_KEY=

# --- Operations ---------------------------------------------------------------
# Set to false in production to hide the Swagger page and the API description.
# API_DOCS_ENABLED=true
# How many days of nightly database dumps to keep (ops/backup.sh and the backup service).
# BACKUP_RETENTION_DAYS=14
